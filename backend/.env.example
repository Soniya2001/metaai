# Meta Model API Credentials
MODEL_API_KEY=your_meta_model_api_key_here
META_TRANSLATION_MODEL=muse-spark-1.3
META_TRANSCRIPTION_MODEL=muse-voice-transcribe-1.0
META_API_BASE_URL=https://api.meta.ai/v1

# Application Security
SECRET_KEY=change_this_to_a_secure_random_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default with clean PostgreSQL migration path)
DATABASE_URL=sqlite:///./echopulse.db

# Storage & Audio
UPLOAD_DIR=./uploads
MAX_AUDIO_SIZE_BYTES=26214400

# Text-to-Speech Adapter Config (none, browser_delegated, local, elevenlabs)
TTS_PROVIDER=browser_delegated
TTS_API_KEY=

